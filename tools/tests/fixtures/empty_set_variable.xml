<policies>
    <inbound>
        <base />
        <include-fragment fragment-id="securepath-app-map" />
        <include-fragment fragment-id="securepath-inbound" />
        <set-variable name="rdwrRenderedBlockPage" />
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401">
            <openid-config url="https://login.example.com/.well-known/openid-configuration" />
        </validate-jwt>
        <set-backend-service backend-id="orders-pool" />
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <include-fragment fragment-id="securepath-outbound" />
    </outbound>
    <on-error>
        <base />
        <include-fragment fragment-id="securepath-onerror" />
        <choose>
            <when condition="@((bool)context.Variables.GetValueOrDefault("rdwrUnrouted", false))">
                <include-fragment fragment-id="securepath-app-map" />
                <include-fragment fragment-id="securepath-inbound" />
                <include-fragment fragment-id="securepath-outbound" />
            </when>
        </choose>
    </on-error>
</policies>
